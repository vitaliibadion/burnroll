{
  "sourceLanguage" : "en",
  "strings" : {
    "* Space is estimated. Items remain recoverable in Apple Photos’ Recently Deleted album for up to 30 days." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Speicher ist geschätzt. Elemente bleiben bis zu 30 Tage in Zuletzt gelöscht von Apple Fotos wiederherstellbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* El espacio es estimado. Los elementos se pueden recuperar en Eliminados hace poco de Fotos de Apple hasta 30 días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* L’espace est une estimation. Les éléments restent récupérables dans Récemment supprimés d’Apple Photos jusqu’à 30 jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Lo spazio è una stima. Gli elementi restano recuperabili in Eliminati di recente di Foto Apple fino a 30 giorni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "*容量は概算です。項目は最大30日間、Appleの写真の「最近削除した項目」から復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* 공간은 추정치입니다. 항목은 최대 30일 동안 Apple 사진의 최근 삭제된 항목에서 복구할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Ruimte is een schatting. Items blijven tot 30 dagen herstelbaar in Recent verwijderd van Apple Foto’s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Miejsce jest szacunkowe. Elementy można odzyskać z Ostatnio usuniętych w Zdjęciach Apple do 30 dni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* O espaço é uma estimativa. Os itens continuam recuperáveis em Apagados recentemente do Fotos da Apple por até 30 dias."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Простір орієнтовний. Елементи можна відновити з «Нещодавно видалені» в Фото Apple до 30 днів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* 空间为估算。项目在 Apple 照片的“最近删除”中最多可恢复 30 天。"
          }
        }
      }
    },
