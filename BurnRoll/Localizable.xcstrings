        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bladwijzer is bij. Nieuwe foto’s verschijnen automatisch, of kies Bekeken of Alle items via de knop linksboven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakładka jest aktualna. Nowe zdjęcia pojawią się same albo wybierz Przejrzane lub Wszystkie elementy u góry po lewej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu marcador está em dia. Fotos novas aparecem sozinhas, ou escolha Revisados ou Todos os itens no botão superior esquerdo."
