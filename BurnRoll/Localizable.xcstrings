        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽으로 밀면 삭제, 오른쪽으로 밀면 유지. 첫 사진에서 둘 다 보여 줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om te wissen. Veeg naar rechts om te bewaren. De eerste foto toont beide."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W lewo, aby usunąć. W prawo, aby zachować. Pierwsze zdjęcie pokaże oba gesty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize à esquerda para queimar. À direita para manter. A primeira foto mostra os dois."
