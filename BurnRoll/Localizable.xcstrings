    "Apple Photos keeps deleted items in Recently Deleted for up to 30 days. Empty that album to recover storage immediately." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Fotos behält gelöschte Elemente bis zu 30 Tage in Zuletzt gelöscht. Leere dieses Album, um Speicher sofort freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos de Apple guarda lo eliminado en Eliminados hace poco hasta 30 días. Vacía ese álbum para liberar espacio al momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Photos conserve les éléments supprimés dans Récemment supprimés jusqu’à 30 jours. Vide cet album pour libérer de l’espace tout de suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto di Apple tiene gli elementi eliminati in Eliminati di recente fino a 30 giorni. Svuota quell’album per liberare spazio subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleの写真は削除した項目を最大30日間「最近削除した項目」に保管します。すぐに容量を空けるにはそのアルバムを空にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 사진은 삭제한 항목을 최대 30일 동안 최근 삭제된 항목에 보관합니다. 바로 공간을 확보하려면 해당 앨범을 비우세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Foto’s bewaart verwijderde items tot 30 dagen in Recent verwijderd. Leeg dat album om meteen ruimte vrij te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia Apple trzymają usunięte elementy w Ostatnio usuniętych do 30 dni. Opróżnij ten album, aby od razu odzyskać miejsce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fotos da Apple guarda itens apagados em Apagados recentemente por até 30 dias. Esvazie esse álbum para liberar espaço imediatamente."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото Apple зберігає видалені елементи в «Нещодавно видалені» до 30 днів. Очистіть той альбом, щоб одразу звільнити місце."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 照片会将删除的项目保留在“最近删除”中最多 30 天。清空该相簿可立即回收空间。"
          }
        }
      }
    },
