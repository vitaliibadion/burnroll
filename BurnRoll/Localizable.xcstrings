    "BurnRoll" : {
      "comment" : "The name of the app.",
      "isCommentAutoGenerated" : true
    },
    "BurnRoll %@" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BurnRoll %@"
          }
        },
        "en" : {
