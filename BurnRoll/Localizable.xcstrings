        }
      }
    },
    "Swipe through your camera roll one decision at a time. Your library and settings stay as they are." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische dich durch die Mediathek, eine Entscheidung nach der anderen. Mediathek und Einstellungen bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza el carrete, una decisión cada vez. Tu fototeca y ajustes no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais défiler ta pellicule, une décision à la fois. Ta bibliothèque et tes réglages restent inchangés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri il rullino una decisione alla volta. Libreria e impostazioni restano com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラロールを一枚ずつ判断します。ライブラリと設定はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 롤을 한 장씩 결정하세요. 보관함과 설정은 그대로입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg door je camerastream, één keuze tegelijk. Je bibliotheek en instellingen blijven zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj rolkę zdjęcie po zdjęciu. Biblioteka i ustawienia zostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe o rolo uma decisão de cada vez. A biblioteca e os ajustes ficam como estão."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гортайте стрічку по одному рішенню. Бібліотека й налаштування залишаються як є."
