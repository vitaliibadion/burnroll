    "Items you've already reviewed stay marked. Confirm again before anything is deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereits geprüfte Elemente bleiben markiert. Bestätige erneut, bevor etwas gelöscht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los elementos que ya revisaste siguen marcados. Confirma otra vez antes de borrar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les éléments déjà vus restent marqués. Confirme encore avant toute suppression."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elementi già visti restano contrassegnati. Conferma di nuovo prima di qualsiasi eliminazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認済みの項目はマークされたままです。削除の前に再確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 검토한 항목은 표시가 유지됩니다. 삭제 전에 다시 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Items die je al hebt bekeken blijven gemarkeerd. Bevestig opnieuw voordat iets wordt verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przejrzane elementy zostają oznaczone. Potwierdź ponownie, zanim cokolwiek zostanie usunięte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itens já revisados continuam marcados. Confirme de novo antes de qualquer exclusão."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переглянуті елементи лишаються позначеними. Підтвердіть ще раз, перш ніж щось видалиться."
