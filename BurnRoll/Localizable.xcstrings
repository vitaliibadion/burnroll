    "See every thumbnail. Drop anything you still want. Then confirm." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh jedes Vorschaubild. Nimm runter, was du behalten willst. Dann bestätigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira cada miniatura. Quita lo que aún quieres. Luego confirma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vois chaque miniature. Retire ce que tu veux garder. Puis confirme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi ogni miniatura. Togli ciò che vuoi tenere. Poi conferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルを全部見て、残したいものは外してから確定。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 미리보기를 보고, 남길 것은 뺀 다음 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zie elke thumbnail. Haal weg wat je wilt houden. Daarna bevestigen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobacz każdą miniaturę. Odrzuć to, co chcesz zostawić. Potem potwierdź."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja cada miniatura. Tire o que ainda quer. Depois confirme."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Побачте кожну мініатюру. Приберіть те, що хочете лишити. Потім підтвердіть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看每张缩略图，拿掉还想留的，然后再确认。"
          }
        }
      }
    },
