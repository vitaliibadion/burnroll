    "Keep or burn with one gesture. Nothing deletes until you confirm." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten oder brennen mit einer Geste. Nichts wird gelöscht, bis du bestätigst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva o elimina con un gesto. Nada se borra hasta que confirmes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde ou brûle d’un geste. Rien n’est supprimé avant confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni o brucia con un gesto. Niente si elimina finché non confermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一手で残すか削除。確認するまで消えません。"
