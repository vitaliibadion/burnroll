          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your bookmark is up to date. New photos will appear here automatically, or choose Reviewed or All items from the top-left button."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu marcador está al día. Las fotos nuevas aparecen solas, o elige Revisados o Todos los elementos arriba a la izquierda."
          }
        },
        "fr" : {
          "stringUnit" : {
