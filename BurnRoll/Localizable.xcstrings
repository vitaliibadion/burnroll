          "stringUnit" : {
            "state" : "translated",
            "value" : "You have %lld new photos. Want to clean them up? Reviewing should take %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes %lld fotos nuevas. ¿Las limpiamos? Revisar debería llevar %@."
