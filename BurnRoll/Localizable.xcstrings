    "Burn the clutter.\nKeep the memories." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brenn das Überflüssige.\nBehalte die Erinnerungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina el desorden.\nConserva los recuerdos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brûle le superflu.\nGarde les souvenirs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Togli il superfluo.\nTieni i ricordi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要な写真は削除。\n思い出は残す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잡동사니는 지우고\n추억은 남기세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wis de rommel.\nBewaar de herinneringen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuń bałagan.\nZachowaj wspomnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queime a bagunça.\nMantenha as memórias."
          }
        },
        "uk" : {
          "stringUnit" : {
