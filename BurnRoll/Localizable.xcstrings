        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 제스처로 유지 또는 삭제. 확인 전에는 지워지지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaren of wissen met één gebaar. Niets verdwijnt tot je bevestigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zachowaj lub usuń jednym gestem. Nic nie znika, dopóki nie potwierdzisz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ou queime com um gesto. Nada some até você confirmar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть або видаліть одним жестом. Нічого не зникне, доки ви не підтвердите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
