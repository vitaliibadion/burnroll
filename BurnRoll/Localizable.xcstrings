    "Photos couldn’t complete the deletion. Try again, and confirm Delete on the system sheet." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos konnte das Löschen nicht abschließen. Versuche es erneut und bestätige Löschen im Systemdialog."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos no pudo completar el borrado. Inténtalo de nuevo y confirma Borrar en la hoja del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos n’a pas pu terminer la suppression. Réessaie et confirme Supprimer dans la feuille système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto non ha completato l’eliminazione. Riprova e conferma Elimina nel foglio di sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真アプリが削除を完了できませんでした。もう一度試し、システムのシートで「削除」を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 앱이 삭제를 완료하지 못했습니다. 다시 시도하고 시스템 시트에서 삭제를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto’s kon verwijderen niet voltooien. Probeer opnieuw en bevestig Verwijderen in het systeemvenster."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia nie dokończyły usuwania. Spróbuj ponownie i potwierdź Usuń na arkuszu systemowym."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fotos não concluiu a exclusão. Tente de novo e confirme Apagar na folha do sistema."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото не завершило видалення. Спробуйте ще раз і підтвердіть «Видалити» в системному аркуші."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“照片”未能完成删除。请重试，并在系统表单中确认删除。"
          }
        }
      }
    },
    "Pinch or double tap to zoom. Swipe up or down to close when not zoomed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Zoomen kneifen oder doppeltippen. Nach oben oder unten wischen zum Schließen, wenn nicht gezoomt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pellizca o toca dos veces para zoom. Desliza arriba o abajo para cerrar si no hay zoom."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pince ou double-touche pour zoomer. Glisse haut ou bas pour fermer hors zoom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pizzica o tocca due volte per lo zoom. Scorri su o giù per chiudere se non sei ingrandito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ピンチまたはダブルタップでズーム。ズームしていなければ上下スワイプで閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핀치 또는 두 번 탭하여 확대. 확대하지 않은 상태에서는 위나 아래로 밀어 닫습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knijp of dubbeltik om te zoomen. Veeg omhoog of omlaag om te sluiten als je niet ingezoomd bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ściśnij lub stuknij dwukrotnie, aby powiększyć. Przesuń w górę lub w dół, aby zamknąć bez powiększenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belisque ou toque duas vezes para zoom. Deslize para cima ou para baixo para fechar sem zoom."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зведіть пальці або двічі торкніться для масштабу. Без збільшення проведіть угору чи вниз, щоб закрити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捏合或点两下缩放。未放大时可上下滑动关闭。"
          }
        }
      }
    },
