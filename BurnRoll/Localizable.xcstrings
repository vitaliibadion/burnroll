    "Swipe left to burn or right to keep. Double tap to open fullscreen." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach links zum Brennen oder nach rechts zum Behalten. Doppeltippen öffnet Vollbild."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para eliminar o a la derecha para conservar. Toca dos veces para pantalla completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisse à gauche pour brûler ou à droite pour garder. Double toucher pour le plein écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorri a sinistra per bruciare o a destra per tenere. Tocca due volte per lo schermo intero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左スワイプで削除、右で残す。ダブルタップで全画面。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 스와이프는 삭제, 오른쪽은 유지. 두 번 탭하면 전체 화면."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veeg naar links om te wissen of naar rechts om te bewaren. Dubbeltik voor volledig scherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W lewo, aby usunąć, w prawo, aby zachować. Podwójne stuknięcie otwiera pełny ekran."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deslize à esquerda para queimar ou à direita para manter. Toque duas vezes para tela cheia."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вліво — видалити, вправо — зберегти. Двічі торкніться для повного екрана."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向左滑清除，向右滑保留。点两下打开全屏。"
          }
        }
      }
    },
    "Swipe left to Burn. Swipe right to Keep. The first photo will show you both." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische nach links zum Brennen. Wische nach rechts zum Behalten. Das erste Foto zeigt beides."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desliza a la izquierda para eliminar. A la derecha para conservar. La primera foto muestra ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glisse à gauche pour brûler. Glisse à droite pour garder. La première photo montre les deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
